{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/pigcode/ai/compatibility/schema/kernel-store-compatibility.schema.json",
  "title": "Pigcode Phase 3 Kernel and Store compatibility manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "formatVersion",
    "phase",
    "implementationCommit",
    "dartSdkConstraint",
    "sources",
    "claims",
    "evidence",
    "knownUnsupported"
  ],
  "properties": {
    "$schema": {
      "const": "./schema/kernel-store-compatibility.schema.json"
    },
    "formatVersion": {
      "const": 1
    },
    "phase": {
      "const": "phase-3-kernel-store"
    },
    "implementationCommit": {
      "type": "string",
      "pattern": "^(pending-main-merge|[a-f0-9]{40})$"
    },
    "dartSdkConstraint": {
      "const": "^3.6.0"
    },
    "sources": {
      "type": "array",
      "minItems": 4,
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "claims": {
      "type": "array",
      "minItems": 28,
      "maxItems": 28,
      "items": {
        "$ref": "#/$defs/claim"
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 28,
      "maxItems": 28,
      "items": {
        "$ref": "#/$defs/evidence"
      }
    },
    "knownUnsupported": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": {
        "$ref": "#/$defs/knownUnsupported"
      }
    }
  },
  "$defs": {
    "pathDigest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "source": {
      "allOf": [
        {
          "$ref": "#/$defs/pathDigest"
        },
        {
          "type": "object",
          "required": [
            "id",
            "kind"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "kind": {
              "enum": [
                "schema",
                "inventory",
                "source",
                "contract"
              ]
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "component",
        "level",
        "summary",
        "sourceRefs",
        "evidenceRef",
        "knownUnsupportedRefs"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^P3-(KERNEL|STORE|CROSS)-[0-9]{2}$"
        },
        "component": {
          "enum": [
            "kernel",
            "store",
            "cross-package"
          ]
        },
        "level": {
          "enum": [
            "implemented",
            "verified"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "sourceRefs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "evidenceRef": {
          "type": "string",
          "minLength": 1
        },
        "knownUnsupportedRefs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "claimId",
        "claimLevel",
        "kind",
        "role",
        "transport",
        "version",
        "capabilityProfile",
        "platform",
        "peer",
        "dartSdkConstraint",
        "evidenceCommit",
        "scenario",
        "artifacts",
        "verifiedAt",
        "result"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^EV-P3-(KERNEL|STORE|CROSS)-[0-9]{2}$"
        },
        "claimId": {
          "type": "string",
          "pattern": "^P3-(KERNEL|STORE|CROSS)-[0-9]{2}$"
        },
        "claimLevel": {
          "enum": [
            "implemented",
            "verified"
          ]
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "transport": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "capabilityProfile": {
          "type": "string",
          "minLength": 1
        },
        "platform": {
          "type": "string",
          "minLength": 1
        },
        "peer": {
          "type": "string",
          "minLength": 1
        },
        "dartSdkConstraint": {
          "const": "^3.6.0"
        },
        "evidenceCommit": {
          "type": "string",
          "pattern": "^(pending-main-merge|[a-f0-9]{40})$"
        },
        "scenario": {
          "type": "string",
          "minLength": 1
        },
        "artifacts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/pathDigest"
          }
        },
        "verifiedAt": {
          "type": "string",
          "format": "date-time"
        },
        "result": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "assertions"
          ],
          "properties": {
            "status": {
              "const": "passed"
            },
            "assertions": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "knownUnsupported": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "scope",
        "summary"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^KU-P3-[A-Z0-9-]+$"
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
