{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/pigcode/ai/compatibility/schema/protocol-foundation-compatibility.schema.json",
  "title": "Pigcode Phase 2a protocol foundation compatibility manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "formatVersion",
    "phase",
    "implementationCommit",
    "dartSdkConstraint",
    "sources",
    "claims",
    "evidence",
    "knownUnsupported"
  ],
  "properties": {
    "$schema": {
      "const": "./schema/protocol-foundation-compatibility.schema.json"
    },
    "formatVersion": {
      "const": 1
    },
    "phase": {
      "const": "phase-2a-protocol-foundation"
    },
    "implementationCommit": {
      "type": "string",
      "pattern": "^(pending-main-merge|[a-f0-9]{40})$"
    },
    "dartSdkConstraint": {
      "const": "^3.6.0"
    },
    "sources": {
      "type": "array",
      "minItems": 3,
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "claims": {
      "type": "array",
      "minItems": 34,
      "items": {
        "$ref": "#/$defs/claim"
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 34,
      "items": {
        "$ref": "#/$defs/evidence"
      }
    },
    "knownUnsupported": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/knownUnsupported"
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceId",
        "release",
        "revision",
        "wireVersion",
        "artifactRefs"
      ],
      "properties": {
        "sourceId": {
          "type": "string",
          "minLength": 1
        },
        "release": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "wireVersion": {
          "type": "string",
          "minLength": 1
        },
        "artifactRefs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "protocol",
        "level",
        "summary",
        "sourceRefs",
        "evidenceRefs",
        "knownUnsupportedRefs"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^P2A-(UTIL|ACP|MCP|CROSS)-[0-9]{2}$"
        },
        "protocol": {
          "enum": [
            "protocol-utils",
            "acp",
            "mcp",
            "cross-package"
          ]
        },
        "level": {
          "enum": [
            "implemented",
            "verified",
            "conformant"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "sourceRefs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "evidenceRefs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "knownUnsupportedRefs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "digest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "path",
        "sha256"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "claimId",
        "claimLevel",
        "kind",
        "role",
        "transport",
        "version",
        "capabilityProfile",
        "platform",
        "peer",
        "dartSdkConstraint",
        "evidenceCommit",
        "artifact",
        "verifiedAt",
        "result"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "claimId": {
          "type": "string",
          "pattern": "^P2A-(UTIL|ACP|MCP|CROSS)-[0-9]{2}$"
        },
        "claimLevel": {
          "enum": [
            "implemented",
            "verified",
            "conformant"
          ]
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "transport": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "capabilityProfile": {
          "type": "string",
          "minLength": 1
        },
        "platform": {
          "type": "string",
          "minLength": 1
        },
        "peer": {
          "$ref": "#/$defs/digest"
        },
        "dartSdkConstraint": {
          "const": "^3.6.0"
        },
        "evidenceCommit": {
          "type": "string",
          "pattern": "^(pending-main-merge|[a-f0-9]{40})$"
        },
        "artifact": {
          "$ref": "#/$defs/digest"
        },
        "verifiedAt": {
          "type": "string",
          "format": "date-time"
        },
        "result": {
          "type": "object"
        }
      }
    },
    "knownUnsupported": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "scope",
        "summary"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
