(version 1)
(deny default)
(import "system.sb")
(allow process*)
(allow sysctl-read)
(allow file-read-metadata (literal "/workspace"))
(allow file-read* (subpath "/workspace/read-only"))
(allow file-read-metadata (literal "/workspace"))
(allow file-read* (subpath "/workspace/read-write"))
(allow file-write* (subpath "/workspace/read-write"))
(allow network-outbound (remote ip "localhost:4317"))
(allow network-bind (local tcp "*:4317"))
(allow network-inbound (local tcp "*:4317"))
(deny file-read* (subpath "/Users/example/.ssh"))
(deny file-write* (subpath "/workspace/read-only"))
